# Credenciales de base de datos PostgreSQL
DB_USER=ts_admin
DB_PASS=cambiar_password_seguro

# Configuracion de seguridad JWT
JWT_SECRET=cambiar_llave_secreta_jwt

# Credenciales de mensajeria RabbitMQ
MQ_USER=ts_mq_user
MQ_PASS=cambiar_password_mq

# Credenciales de almacenamiento de objetos MinIO
MINIO_USER=ts_minio_admin
MINIO_PASS=cambiar_password_minio

# Llaves externas de servicios
# Reemplaza STRIPE_API_KEY con tu clave sk_test_... de Stripe para activar Stripe Checkout real.
# Si se deja el placeholder, booking-service usa automaticamente el modo simulado.
STRIPE_API_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost
LLM_API_KEY=api_key_placeholder

# Crear una copia de este archivo antes de levantar los contenedores
# o valio cola (llamar .env)